# Needed for everything
# Claude API key: claim extraction, the agent, evals (console.anthropic.com)
ANTHROPIC_API_KEY=
# Runloop API key: booting apps in sandboxes (runloop.ai)
RUNLOOP_API_KEY=

# Only for the GitHub App (npm run dev); local mode and config testing don't need these
# From the App's settings page (General tab)
GITHUB_APP_ID=
# Path to the .pem private key downloaded from the App's settings page; keep it outside the repo
GITHUB_PRIVATE_KEY_PATH=
# Must match "Webhook secret" in the App's settings
GITHUB_WEBHOOK_SECRET=
# Your smee.io channel URL; must also be the App's "Webhook URL"
SMEE_URL=

# Optional
PORT=3000
# Max claim extractions at once (the rest wait)
EXTRACT_CONCURRENCY=4
# Max app boots at once; each holds a sandbox (the Runloop trial allows 3)
BOOT_CONCURRENCY=2
# Passwords for personas whose config says { secret: NAME } go here too, e.g. GT_MEALIE_COOK_PASSWORD=
