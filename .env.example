# From the GitHub App settings page (General tab)
GITHUB_APP_ID=
# Path to the .pem private key downloaded from the App settings page
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
# Must match "Webhook secret" in the App settings
GITHUB_WEBHOOK_SECRET=

# smee.io channel URL — must also be the App's "Webhook URL"
SMEE_URL=https://smee.io/your-channel

PORT=3000

# Claude API key for claim extraction and evals (console.anthropic.com)
ANTHROPIC_API_KEY=
