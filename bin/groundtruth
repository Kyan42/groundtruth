#!/bin/sh
# Runs Groundtruth's command line with the project's own Python: bin/groundtruth <command> [arguments]
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 1
py="$here/.venv/bin/python"
if [ ! -x "$py" ]; then
  echo "groundtruth: there is no Python at $py. Set up Groundtruth's .venv first (see README.md, Quick start)." >&2
  exit 1
fi
exec "$py" "$here/groundtruth.py" "$@"
