diff -ruN -x node_modules -x .next -x data -x .groundtruth -x tsconfig.tsbuildinfo cbay/app/components/QuickAddButton.tsx cbay/app/components/QuickAddButton.tsx
--- cbay/app/components/QuickAddButton.tsx	1969-12-31 16:00:00
+++ cbay/app/components/QuickAddButton.tsx	2026-11-09 22:22:58
@@ -0,0 +1,60 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+
+export function QuickAddButton({
+  listingId,
+  title,
+  soldOut,
+}: {
+  listingId: string;
+  title: string;
+  soldOut: boolean;
+}) {
+  const router = useRouter();
+  const [pending, setPending] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  async function quickAdd() {
+    setPending(true);
+    setError(null);
+    try {
+      const response = await fetch("/api/cart", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ listingId }),
+      });
+      const body = await response.json();
+      if (!response.ok) {
+        setError(typeof body.error === "string" ? body.error : "Could not add to cart.");
+        return;
+      }
+      router.refresh();
+    } catch {
+      setError("Could not add to cart.");
+    } finally {
+      setPending(false);
+    }
+  }
+
+  return (
+    <div className="quick-add">
+      <button
+        type="button"
+        className="quick-add-button"
+        aria-label={`Quick add ${title}`}
+        data-testid={`quick-add-${listingId}`}
+        disabled={soldOut || pending}
+        onClick={quickAdd}
+      >
+        Quick add
+      </button>
+      {error ? (
+        <p className="inline-error" data-testid={`quick-add-error-${listingId}`}>
+          {error}
+        </p>
+      ) : null}
+    </div>
+  );
+}
