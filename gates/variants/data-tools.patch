+// Shared by the Groundtruth data tools: read one JSON object from standard input, print one JSON object on standard
+// output, and report anything else on standard error with a non-zero exit.
+
+export async function readInput(fields) {
+  const chunks = [];
+  for await (const chunk of process.stdin) {
+    chunks.push(chunk);
+  }
+  const text = Buffer.concat(chunks).toString("utf8").trim();
+  let input;
+  try {
+    input = text ? JSON.parse(text) : {};
+  } catch {
+    fail("The input is not valid JSON.");
+  }
+  if (input === null || typeof input !== "object" || Array.isArray(input)) {
+    fail("The input must be one JSON object.");
+  }
+  for (const key of Object.keys(input)) {
+    if (!(key in fields)) {
+      fail(`Unknown input: ${key}.`);
+    }
+  }
+  for (const [key, { type, optional }] of Object.entries(fields)) {
+    const value = input[key];
+    if (value === undefined) {
+      if (!optional) {
+        fail(`Missing input: ${key}.`);
+      }
+      continue;
+    }
+    const ok = type === "integer" ? Number.isInteger(value) : typeof value === type;
+    if (!ok) {
+      fail(`${key} must be ${type === "integer" ? "an integer" : `a ${type}`}.`);
+    }
+  }
+  return input;
+}
+
+export function appUrl(path) {
+  const base = (process.env.GROUNDTRUTH_APP_URL || "").replace(/\/+$/, "");
+  return base ? `${base}${path}` : null;
+}
+
+export function done(result) {
+  process.stdout.write(`${JSON.stringify(result)}\n`);
+  process.exit(0);
+}
+
+export function fail(message) {
+  process.stderr.write(`${message}\n`);
+  process.exit(1);
+}
