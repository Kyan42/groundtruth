+// Groundtruth data tool make_listing: puts one listing up for sale through the shop's own store code
+// (addListing in lib/store.ts), so it lives in data/state.json with everything else the reset command clears.
+import { addListing } from "../../lib/store.ts";
+import { appUrl, done, fail, readInput } from "./io.mjs";
+
+const input = await readInput({
+  title: { type: "string" },
+  price_cents: { type: "integer" },
+  sold_out: { type: "boolean", optional: true },
+});
+
+let listing;
+try {
+  listing = addListing({ title: input.title, priceCents: input.price_cents, soldOut: input.sold_out === true });
+} catch (error) {
+  fail(error instanceof Error ? error.message : String(error));
+}
+
+const dollars = (listing.priceCents / 100).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+done({
+  id: listing.id,
+  page: `/listings/${listing.id}`,
+  url: appUrl(`/listings/${listing.id}`),
+  title: listing.title,
+  price: `$${dollars}`,
+  sold_out: listing.soldOut,
+});
