+// Groundtruth data tool make_order: buys one listing through the shop's own order endpoint (the one Buy It Now uses),
+// so the order exists exactly as if a shopper had placed it.
+import { appUrl, done, fail, readInput } from "./io.mjs";
+
+const input = await readInput({ listing_id: { type: "string" } });
+const endpoint = appUrl("/api/orders");
+if (!endpoint) {
+  fail("GROUNDTRUTH_APP_URL is not set, so the shop cannot be reached.");
+}
+
+let response;
+let body;
+try {
+  response = await fetch(endpoint, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ listingId: input.listing_id }),
+  });
+  body = await response.json();
+} catch (error) {
+  fail(`Could not reach the shop at ${endpoint}: ${error instanceof Error ? error.message : String(error)}`);
+}
+if (!response.ok) {
+  fail(`The shop refused the order (${response.status}): ${body && body.error ? body.error : "no reason given"}`);
+}
+done({ order_id: body.orderId, page: `/orders/${body.orderId}`, url: appUrl(`/orders/${body.orderId}`) });
